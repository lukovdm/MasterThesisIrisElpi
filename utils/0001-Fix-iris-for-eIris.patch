-  Global Instance frame_twp p s E e R Φ Ψ :
-    (FrameInstantiateExistDisabled → ∀ v, Frame p R (Φ v) (Ψ v)) →
-    Frame p R (WP e @ s; E [{ Φ }]) (WP e @ s; E [{ Ψ }]) | 2.
-  Proof.
-    rewrite /Frame=> HR. rewrite twp_frame_l. apply twp_mono, HR. constructor.
-  Qed.
