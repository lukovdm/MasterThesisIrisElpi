accumulate eIris/common/stdpp.
accumulate eIris/proofmode/elpi/reduction.
accumulate eIris/proofmode/elpi/iris_ltac.
accumulate eIris/proofmode/elpi/eiris_tactics.

shorten coq.ltac.{ open, thenl, all }.

pred eiPoseProper i:igoal, i:term, i:term, o:ident, o:igoal.
eiPoseProper (igoal N Type Proof) R F (iAnon N) (igoal NS PosedType PosedProof) :-
  increase-ctx-count N NS,
  ident->term (iAnon N) _ NT,
  (@no-tc! => coq.elaborate-skeleton 
                {{ tac_pose_proof _ lp:NT _ _ (into_emp_valid_proj _ _ _ (iproper_top_to_iproper _ _ _ _ _ (_ : IProperTop lp:R lp:F _))) _}} 
                Type Proof ok),
  Proof = {{ tac_pose_proof _ _ _ _ (into_emp_valid_proj _ _ lp:IEVProof (iproper_top_to_iproper _ _ _ _ _ (lp:IPTProof : IProperTop _ _ _))) lp:PosedProof }},
  coq.ltac.collect-goals IEVProof [G1] _,
  open (coq.ltac.call "iIntoEmpValid" []) G1 TCGL,
  all (open tc_solve) TCGL [],
  coq.ltac.collect-goals IPTProof [G2] _,
  open tc_solve G2 [],
  coq.typecheck PosedProof NormType ok,
  pm-reduce NormType PosedType.

pred eiApplyProper i:igoal, i:term, i:term, o:list igoal.
eiApplyProper IH R F IHS :-
  if-debug (coq.say "eiApplyProper"),
  eiPoseProper IH R F ID IHPosed,
  if-debug (coq.say "Posed Lemma" {igoal->string IHPosed}),
  eiApplyProper.aux IHPosed ID IHS.
eiApplyProper.aux IH ID [IH'] :- 
  if-debug (coq.say "simpleApplyHyp"),
  eiApplySimpleHyp IH ID IH'.
eiApplyProper.aux IH ID [] :- 
  if-debug (coq.say "simpleApplyExact"),
  eiApplySimpleExact IH ID.
eiApplyProper.aux IH ID [IHL | IHS] :-
  if-debug (coq.say "specialize"),
  eiSpecializeWand IH ID IHL IHR,
  if-debug (coq.say "Specialized Lemma" {igoal->string IHL} {igoal->string IHR}),
  eiApplyProper.aux IHR ID IHS.

pred unfold-id i:string, i:term, o:term.
unfold-id S I O :- 
  coq.locate S (const IP),
  unfold-gref (const IP) I O.

pred unfold-gref i:gref, i:term, o:term.
unfold-gref (const IP) I O :-
  coq.env.const IP (some Bo) _,
  ((copy (global (const IP)) Bo :- !) => copy I I'),
  coq.reduction.lazy.bi-norm I' O.

pred esteps i:igoal.
esteps (igoal _ Type _ as IH) :-
  if-debug (coq.say "################# Goal #################" {igoal->string IH} ""),
  esteps.conn Type R LF RF, !,
  esteps.do IH R LF RF.

pred esteps.conn i:term, o:term, o:term, o:term.
esteps.conn Type R LF RF:-
  top-relation Type R, !,
  relation-on Type LF RF.

pred top-relation i:term, o:term.
top-relation {{ envs_entails _ lp:{{ app PS }} }} C :- C = app {std.take 2 PS}.

pred relation-on i:term, o:term, o:term.
relation-on {{ envs_entails _ lp:{{ app AS }} }} L R :- 
  std.take-last 2 AS [L, R].

pred esteps.do i:igoal, i:term, i:term, i:term.
esteps.do IH {{ @iRespectful _ }} _ _ :- !,
  if-debug (coq.say "==>"),
  eiIntros [iPure (none), iPure (none), iIntuitionistic iFresh] IH esteps.
esteps.do IH {{ @iPointwise_relation _ }} _ _ :- !,
  if-debug (coq.say ".>"), !,
  eiIntros [iPure (none)] IH esteps.
esteps.do H {{ @iPersistent_relation _ }} _ _ :- !,
  if-debug (coq.say "□>"),
  eiModIntro H ModH, !,
  esteps ModH.
esteps.do IH _ F F :-
  if-debug (coq.say "Applying wand identity" {coq.term->string F}),
  eiIntros [iFresh, iDone] IH (_\ if-debug (coq.say "done failed"), fail).
esteps.do IH _ F F :-
  if-debug (coq.say "Applying assumption" {coq.term->string F}),
  eiIntros [iDone] IH (_\ if-debug (coq.say "done failed"), fail).
esteps.do IH R (app [F | FS]) _ :- 
  std.exists { std.iota {calc ({std.length FS} + 1) } } (n\ std.take n FS FS'),
  if-debug (coq.say "Apply relation" {coq.term->string R} "with" {coq.term->string (app [F | FS'])}),
  eiApplyProper IH R (app [F | FS']) HS, !,
  std.map HS (x\r\ esteps x) _.
esteps.do (igoal N Type Proof) _ (app [global (const F) | _ ]) _ :-
  if-debug (coq.say "Unfolding" F),
  unfold-gref (const F) Type UnfoldedType, !,
  esteps (igoal N UnfoldedType Proof).
esteps.do (igoal N Type Proof) _ (global (const F)) _ :-
  if-debug (coq.say "Unfolding" F),
  unfold-gref (const F) Type UnfoldedType, !,
  esteps (igoal N UnfoldedType Proof).
esteps.do IH _ _ _ :-
  if-debug (coq.say "Applying done"),
  eiIntros [iDone] IH (_\ if-debug (coq.say "done failed"), fail).
esteps.do _ T F _ :- !,
  if-debug (coq.say "No case for relation" {coq.term->string T} "with " {coq.term->string F} "😢 stopping" T F).

pred eiunfold-id i:id, i:goal, o:goal.
eiunfold-id ID (goal Ctx R T P A) (goal Ctx R T' P A) :-
  unfold-id ID T T',
  coq.typecheck P T' ok.

pred esolve-proper i:goal, o:list sealed-goal.
esolve-proper G [] :-
  eiunfold-id "IProper" G G',
  ltac.intros-forall G' (h\ sigma IH\
    eiOfCoqProof h IH,
    esteps IH
  ).
